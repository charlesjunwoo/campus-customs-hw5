# Copy to hw5/.env and fill in your own key. Never commit .env.
# Portkey gateway key used for every agent call (OpenAI gpt-6-luna via https://api.portkey.ai/v1).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: which database the MCP server uses (relative to hw5/). Default shown.
# CC_DB_PATH=data/campus_customs_new.db

# Optional (frontend): put in frontend/.env.local if the API is not at the default address.
# VITE_API_BASE=http://localhost:8000
